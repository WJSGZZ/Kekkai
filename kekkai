def t(zh, en):
    return zh if os.environ.get("KEKKAI_LANG", "zh") == "zh" else en


def q(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def info(app):
    plist = plistlib.load(open(Path(app, "Contents/Info.plist"), "rb"))
    bundle_id = plist["CFBundleIdentifier"]
    if bundle_id == "com.github.Electron":  # 有的软件没改 Electron 的默认 id，按 App 名区分
        bundle_id += "." + re.sub(r"[^A-Za-z0-9.-]", "-", Path(app).stem)
    return bundle_id, plist["CFBundleExecutable"]


def load_rule(bundle_id):
    p = ROOT / "rules" / f"{bundle_id}.json"
    return json.loads(p.read_text()) if p.exists() else {}


def entitlements(app):
    r = subprocess.run(["codesign", "-d", "--entitlements", "-", "--xml", app], capture_output=True)
    try:
        return plistlib.loads(r.stdout) if r.stdout else {}
    except Exception:
        return {}


def settings():
    p = STATE / "settings.json"
    return json.loads(p.read_text()) if p.exists() else {}


def save_settings(data):
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "settings.json").write_text(json.dumps(data, ensure_ascii=False, indent=1))


def set_field(bundle_id, key, value):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    if value == "-":
        entry.pop(key, None)
    else:
        entry[key] = value
    save_settings(data)


def set_tz(bundle_id, tz):
    if tz != "-" and not Path("/usr/share/zoneinfo", tz).is_file():
        sys.exit(t(f"未知时区：{tz}", f"Unknown time zone: {tz}"))
    set_field(bundle_id, "tz", tz)


def never_list():
    data = settings()
    return data.get("_never", DEFAULT_NEVER)


def never_cmd(action, path=None):
    items = list(never_list())
    if action == "add":
        real = str(Path(path).expanduser().resolve())
        if real not in items:
            items.append(real)
    elif action == "rm":
        real = str(Path(path).expanduser().resolve())
        items = [x for x in items if x != real and x != path]
    if action != "list":
        data = settings()
        data["_never"] = items
        save_settings(data)
    print(json.dumps(items, ensure_ascii=False))


def never_rules():
    # 放在规则最后，优先级高于任何放行
    items = [str(Path(p).resolve()) for p in never_list()]
    return ["(deny file-read* file-write* (with errno 2)", *[f"  (subpath {q(p)})" for p in items], ")"] if items else []


def space_of(bundle_id):
    return SPACES / bundle_id


def display_names(app):
    """App 的名字（含各语言）。Electron 等软件按名字建数据文件夹，如“微信开发者工具”。"""
    p = Path(app, "Contents")
    found = {plistlib.load(open(p / "Info.plist", "rb")).get(k) for k in ("CFBundleName", "CFBundleDisplayName")}
    for f in p.glob("Resources/*.lproj/InfoPlist.strings"):
        r = subprocess.run(["plutil", "-convert", "json", "-o", "-", str(f)], capture_output=True, text=True)
        if r.returncode == 0:
            d = json.loads(r.stdout)
            found |= {d.get("CFBundleName"), d.get("CFBundleDisplayName")}
    return sorted(n for n in found if isinstance(n, str) and n.strip() and "/" not in n and n != "Electron")


def nested_ids(app):
    """App 里附带的小程序和扩展，如 QQ 的 com.tencent.qqexdoc。"""
    ids = set()
    for p in Path(app, "Contents").rglob("Info.plist"):
        if p.parent.name == "Contents" and p.parent.parent.suffix in (".app", ".appex", ".xpc"):
            try:
                ids.add(plistlib.load(open(p, "rb"))["CFBundleIdentifier"])
            except Exception:
                pass
    return ids


def own_names(bundle_id, rule):
    return sorted({bundle_id, *rule.get("names", [])})


def seed_space(bundle_id, rule):
    """首次进入时把软件自己的数据用 APFS 克隆放进模拟区域，原文件不动。"""
    space = space_of(bundle_id)
    fresh = not space.exists()
    SPACES.mkdir(parents=True, exist_ok=True)
    os.chmod(SPACES, 0o777 | 0o1000) if SPACES.stat().st_uid == UID else None
    for d in SPACE_DIRS:
        (space / d).mkdir(parents=True, exist_ok=True)
    os.chmod(space, 0o700)
    for rel in rule.get("space_dirs", []):
        (space / rel).mkdir(parents=True, exist_ok=True)
    if not fresh or not settings().get(bundle_id, {}).get("bring_old_data"):
        return
    for name in own_names(bundle_id, rule):
        for base in OWN_BASES:
            if base in rule.get("skip_seed", []):
                continue
            for src in Path(HOME, "Library", base).glob(name + "*"):
                dst = space / "Library" / base / src.name
                if dst.exists():
                    continue
                dst.parent.mkdir(parents=True, exist_ok=True)
                subprocess.run(["cp", "-cR", str(src), str(dst)], capture_output=True)
        for hp in rule.get("home_paths", []):
            src = Path(HOME, hp)
            if src.exists() and not (space / hp).exists():
                subprocess.run(["cp", "-cR", str(src), str(space / hp)], capture_output=True)


def ancestors(path):
    return [str(p) for p in Path(path).parents if str(p) != "/"]


def blocked_devices(conf):
    return [d for d in DEVICES if conf.get("block", DEFAULT_BLOCK).count(d)]


def set_location(bundle_id, args):
    if args == ["-"]:
        return set_field(bundle_id, "location", "-")
    lat, lon = float(args[0]), float(args[1])
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        sys.exit(t("经纬度超出范围", "Latitude or longitude out of range"))
    rest = args[2:]
    mars = rest[:1] == ["--mars"]  # 界面在中国大陆选点时已换算成 WGS-84，记下来以便地图上换回显示
    rest = rest[1:] if rest[:1] in (["--mars"], ["--wgs"]) else rest
    set_field(bundle_id, "location", {"lat": lat, "lon": lon, "name": " ".join(rest), "mars": mars})


def set_block(bundle_id, device, on):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    items = [d for d in entry.get("block", DEFAULT_BLOCK) if d != device] + ([device] if on else [])
    entry["block"] = sorted(items)
    save_settings(data)


def common_rules(rule, conf):
    L = [";; 不许借系统工具跑到结界外",
         "(deny process-exec", *[f"  (literal {q(x)})" for x in NO_EXEC], ")"]
    if not rule.get("keep_username"):
        L += [";; 挡住目录服务，软件查不到真实用户名",
              "(deny mach-lookup", *[f"  (global-name {q(x)})" for x in DIRECTORY_SERVICES], ")"]
    if not conf.get("allow_open"):
        # 经系统拉起的软件不在结界里，挡住它就挡住了借别的软件逃出去的路；代价是不能用浏览器打开链接
        L += [";; 不许拉起其他软件、不许给其他软件发自动化指令", "(deny lsopen)", "(deny appleevent-send)"]
    # 运行中的软件列表来自 launchservicesd，挡住它图形软件就启动不了，所以只挡进程信息
    L += [";; 看不到其他进程", "(deny process-info* (target others))", "(deny process-info-listpids)"]
    if rule.get("block_keychain"):
        L += [";; 挡住钥匙串，代价是依赖钥匙串的登录会失效",
              '(deny mach-lookup (global-name "com.apple.securityd.xpc") (global-name "com.apple.SecurityServer") (global-name "com.apple.secd.keychain"))']
    for d in blocked_devices(conf):
        L += DEVICES[d]
    return L


def allowed_dirs(conf):
    return [str(Path(p).resolve()) for p in conf.get("allow", [])]


def set_allow(bundle_id, action, path):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    real = str(Path(path).expanduser().resolve())
    items = [p for p in entry.get("allow", []) if p != real]
    entry["allow"] = items + [real] if action == "add" else items
    save_settings(data)


def app_groups(app):
    return entitlements(app).get("com.apple.security.application-groups", [])


def build_profile(app, bundle_id, rule, conf, mode, groups=()):
    L = ["(version 1)", "(allow default)", ";; 被挡的路径一律显示为不存在",
         "(deny file-read* file-write* (with errno 2)", *[f"  (subpath {q(b)})" for b in BLOCKED], ")",
         '(deny file-read-data (with errno 2) (literal "/Users"))']
    system = [f"(subpath {q(x)})" for x in rule.get("system_paths", [])]
    system += [f'(regex #"{x.replace("^~", "^" + re.escape(HOME))}")' for x in rule.get("system_regex", [])]
    L.append(f"(allow file-read* (subpath {q(app)}) (literal {q(str(Path(app).parent / 'libfakeloc.dylib'))}))")
    if mode == "space":
        space = str(space_of(bundle_id))
        L += [";; 所有改动都落在模拟区域",
              "(allow file-read-metadata", *[f"  (literal {q(p)})" for p in ancestors(space)],
              '  (literal "/Applications") (literal "/Volumes"))',
              "(allow file-read* file-write*", f"  (subpath {q(space)})", *["  " + s for s in system], ")"]
    else:
        names = own_names(bundle_id, rule)
        # 按 ID 放行 com.tencent.qq 和 com.tencent.qq.share 这类，不放行 com.tencent.qqmusic
        names = sorted({*names, *nested_ids(app)})
        own = [f'(regex #"^{re.escape(HOME)}/Library/([^/]+/)?{re.escape(n)}([-._][^/]*)?(/.*)?$")' for n in names]  # 沙盒正则把 [._-] 当范围，连字符要放最前
        # 按名字只在常见数据目录里放行同名文件夹，避免名字叫 Mail 的软件碰到 ~/Library/Mail
        bases = "|".join(re.escape(b) for b in NAME_BASES)
        own += [f'(regex #"^{re.escape(HOME)}/Library/({bases})/{re.escape(n)}(/.*)?$")' for n in display_names(app)]
        extra = [f"(subpath {q(os.path.join(HOME, x))})" for x in rule.get("home_paths", [])]
        extra += [f"(subpath {q(f'{HOME}/Library/Group Containers/{g}')})" for g in groups]
        approved = allowed_dirs(conf)
        parents = sorted({"/Users", HOME, f"{HOME}/Library", "/Applications", "/Volumes",
                          *(f"{HOME}/Library/{b}" for b in OWN_BASES), *ancestors(app),
                          *(a for p in approved for a in ancestors(p))})
        L += [";; 只放行它自己的数据和你批准的文件夹",
              "(allow file-read-metadata", *[f"  (literal {q(p)})" for p in parents], ")",
              "(allow file-read* file-write*", *["  " + o for o in own], *["  " + x for x in extra],
              *[f"  (subpath {q(p)})" for p in approved], *["  " + s for s in system], ")",
              f"(allow file-read* (literal {q(HOME + '/.CFUserTextEncoding')})",
              f"  (subpath {q(HOME + '/Library/Input Methods')}) (subpath {q(HOME + '/Library/Keyboard Layouts')}))",
              f"(allow file-read-metadata (subpath {q(HOME + '/Library/Keychains')}))"]
    # 模拟区域里没有旧数据，有的软件发现空的旧数据目录就要授权，让这一步看到“目录不存在”
    hide = [f"  (literal {q(os.path.join(space_of(bundle_id), x))})" for x in rule.get("space_hide_stat", []) if mode == "space"]
    if hide:
        L += ["(deny file-read-metadata (with errno 2)", *hide, ")"]
    return "\n".join(L + common_rules(rule, conf) + never_rules()) + "\n"


def effective_mode(bundle_id, conf, rule):
    return conf.get("mode", "real")  # 模拟区域只留给命令行


def label(bundle_id):
    return f"io.github.wjsgzz.kekkai.{bundle_id}"


LEARN_PROFILE = "(version 1)\n(allow default)\n(allow file-read* file-write* (with report))\n"
INTERESTING = (HOME + "/", "/Users/Shared", "/Volumes/", "/Applications/", "/private/tmp/")


def report(app):
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    start = (STATE / f"{bundle_id}.learn-start").read_text().strip()
    r = subprocess.run(["/usr/bin/log", "show", "--start", start, "--style", "compact", "--predicate",
                        'senderImagePath CONTAINS "Sandbox" AND eventMessage CONTAINS " allow file-"'],
                       capture_output=True, text=True, errors="replace")
    seen = {}
    for line in r.stdout.splitlines():
        m = re.search(r" allow file-(read|write)[^ ]* (/.*)$", line)
        if not m or m[2].startswith(app + "/") or not m[2].startswith(INTERESTING):
            continue
        parts = m[2].split("/")
        key = "/".join(parts[:7 if m[2].startswith(HOME + "/Library/") else 5])
        seen.setdefault(key, set()).add(m[1])
    lines = [f"{t('读写', 'R/W') if len(v) > 1 else (t('写', 'W') if 'write' in v else t('读', 'R'))}  {k}" for k, v in sorted(seen.items())]
    head = t(f"{Path(app).stem} 从 {start} 起碰过的外部路径（共 {len(lines)} 组，系统日志可能合并或遗漏）：",
             f"Outside paths {Path(app).stem} touched since {start} ({len(lines)} groups; the system log may merge or drop entries):")
    text = head + "\n" + "\n".join(lines) + "\n"
    out = STATE / f"{bundle_id}-report.txt"
    out.write_text(text)
    print(out)


# 去掉这些后才能用临时签名重签；苹果沙盒不能叠加，受限权限没有描述文件会被系统拒绝
STRIP = ("com.apple.security.app-sandbox", "com.apple.security.inherit", "com.apple.application-identifier",
         "com.apple.developer.", "keychain-access-groups")


def resign(bundle):
    ents = entitlements(bundle)
    kept = {k: v for k, v in ents.items() if not k.startswith(STRIP)}
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "entitlements.plist"
    plistlib.dump(kept, open(tmp, "wb"))
    r = subprocess.run(["codesign", "-f", "-s", "-", "--entitlements", str(tmp), bundle], capture_output=True, text=True)
    if r.returncode:
        sys.exit(t(f"重签名失败：{r.stderr.strip()}", f"Re-signing failed: {r.stderr.strip()}"))


def local_copy(app, bundle_id):
    """在模拟区域里放一份 APFS 克隆，去掉苹果沙盒和强化运行时后重签，原 App 不动。
    自带苹果沙盒的 App 再套一层会崩溃；虚拟定位要注入，也要用副本。"""
    SPACES.mkdir(parents=True, exist_ok=True)
    dst = space_of(bundle_id) / "Applications" / Path(app).name
    stamp = dst.parent / (Path(app).name + ".source")
    src_id = str(Path(app, "Contents/Info.plist").stat().st_mtime)
    if dst.exists() and stamp.exists() and stamp.read_text() == src_id:
        return str(dst)
    if dst.exists():
        shutil.rmtree(dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["cp", "-cR", app, str(dst)], check=True)
    files = [p for p in dst.joinpath("Contents").rglob("*") if not p.is_symlink()]
    bundles = [p for p in files if p.suffix in (".app", ".appex", ".xpc") and p.is_dir()]
    loose = [p for p in files if p.is_file() and os.access(p, os.X_OK) and p.parent.name != "MacOS"
             and any(k.startswith(STRIP) for k in entitlements(str(p)))]  # 如微信的 crashpad_handler
    for b in loose + sorted(bundles, key=lambda p: -len(p.parts)):  # 先签里层
        resign(str(b))
    resign(str(dst))
    stamp.write_text(src_id)
    return str(dst)


def verb(op):
    if op.startswith("file-write"):
        return t("写", "write")
    if op == "file-read-metadata":
        return t("查", "check")
    if op.startswith("file-read"):
        return t("读", "read")
    return t("连", "call") if op == "mach-lookup" else t("看", "view")


NORMAL = ("查你的真实用户名", "Looking up your real user name", "连接系统服务", "Connecting to system services")


def categorize(op, target, app=""):
    """把一条拦截归到人能看懂的类别。"""
    h = HOME + "/"
    if app and target.startswith(app + "/"):
        return t("改动自己的安装目录", "Changing its own app bundle")
    if op.startswith("process-info"):
        return t("查看其他进程", "Looking at other processes")
    if op == "mach-lookup":
        if "opendirectoryd" in target:
            return t("查你的真实用户名", "Looking up your real user name")
        if "pasteboard" in target:
            return t("读写剪贴板", "Using the clipboard")
        return t("连接系统服务", "Connecting to system services")
    if target.startswith(("/Applications/", "/System/Applications/", h + "Applications/")):
        return t("打听你装了哪些软件", "Checking which apps you have")
    if target.startswith(tuple(h + d for d in ("Desktop", "Documents", "Downloads", "Pictures", "Movies", "Music", "Library/Mobile Documents"))):
        return t("你的个人文件", "Your personal files")
    if target.startswith(h + "Library/"):
        return t("其他软件的数据和系统设置", "Other apps' data and settings")
    if target.startswith(h + "."):
        return t("家目录里的隐藏配置（如 .ssh、.cache）", "Hidden settings in your home folder (like .ssh, .cache)")
    if target.startswith("/Volumes/"):
        return t("外接硬盘和其他磁盘", "External and other disks")
    if target.startswith(("/private/tmp", "/Users/Shared")):
        return t("共享的临时文件夹", "Shared temporary folders")
    if target.startswith(h) or target == HOME:
        return t("家目录里的其他东西", "Other things in your home folder")
    return t("其他", "Other")


def blocked(app, quiet=False):
    """从系统日志里取出结界拦下的请求，并入这个软件的长期记录。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    start_file = STATE / f"{bundle_id}.started"
    history_file = STATE / f"{bundle_id}-blocked.json"
    history = json.loads(history_file.read_text()) if history_file.exists() else {}
    if start_file.exists():
        exes = {plistlib.load(open(p, "rb")).get("CFBundleExecutable") for p in Path(app, "Contents").rglob("Info.plist")
                if p.parent.name == "Contents"}
        r = subprocess.run(["/usr/bin/log", "show", "--start", start_file.read_text().strip(), "--style", "compact",
                            "--predicate", 'senderImagePath CONTAINS "Sandbox" AND eventMessage CONTAINS " deny("'],
                           capture_output=True, text=True, errors="replace")
        for line in r.stdout.splitlines():
            m = re.search(r"Sandbox: (.+?)\(\d+\) deny\(\d+\) (\S+) (.*)$", line)
            if not m or m[1] not in exes:
                continue
            target = m[3].strip()
            if m[2].startswith("process-info"):
                target = re.sub(r"\(\d+\)", "", re.sub(r"^others \[|\]$", "", target))
            key = f"{m[2]} {target}"
            e = history.setdefault(key, {"first": line[:19], "count": 0})
            e["last"], e["count"] = line[:19], e["count"] + 1
        history_file.write_text(json.dumps(history, ensure_ascii=False, indent=1))
        start_file.write_text(subprocess.run(["date", "+%Y-%m-%d %H:%M:%S"], capture_output=True, text=True).stdout.strip())
    groups = {}
    for key, e in history.items():
        op, target = key.split(" ", 1)
        groups.setdefault(categorize(op, target, app), []).append((f"{verb(op)}  {target}", e))
    lines = [t(f"{Path(app).stem} 被结界拦下的请求（同一请求系统日志只记一部分，次数偏少）", f"Requests Kekkai blocked for {Path(app).stem} (the system log keeps only some repeats, so counts run low)"), ""]
    for cat, items in sorted(groups.items(), key=lambda g: -sum(e["count"] for _, e in g[1])):
        normal = cat in NORMAL
        lines.append(f"## {cat}（{len(items)}）" + ("　多数软件都会这样，不算流氓" if normal else "") if isChinese()
                     else f"## {cat} ({len(items)})" + ("  Most apps do this; it's normal" if normal else ""))
        for target, e in sorted(items, key=lambda x: -x[1]["count"])[:40]:
            lines.append(f"  {e['count']:>4}×  {target.replace(HOME, '~')}   {e['last']}")
        lines.append("")
    if not history:
        lines.append(t("还没有记录。在结界中打开它用一会儿再来看。", "Nothing yet. Open it in Kekkai, use it for a while, then check again."))
    out = STATE / f"{bundle_id}-blocked.txt"
    out.write_text("\n".join(lines) + "\n")
    if not quiet:
        print(out)


def isChinese():
    return os.environ.get("KEKKAI_LANG", "zh") == "zh"


def run(app, learn=False):
    app = original = str(Path(app).resolve())
    bundle_id, exe = info(app)
    sandboxed = bool(entitlements(app).get("com.apple.security.app-sandbox"))
    rule, conf = load_rule(bundle_id), settings().get(bundle_id, {})
    fake = conf.get("location")
    groups = app_groups(app)
    if sandboxed or fake:  # 虚拟定位要注入，原版的强化运行时不允许，也用副本
        app = local_copy(app, bundle_id)
    binary = f"{app}/Contents/MacOS/{exe}"
    if subprocess.run(["pgrep", "-f", "^" + re.escape(binary)], capture_output=True).returncode == 0:
        return t(f"{Path(app).stem} 已在运行。请先完全退出，再放进结界。", f"{Path(app).stem} is already running. Quit it completely first.")
    mode = effective_mode(bundle_id, conf, rule)
    STATE.mkdir(parents=True, exist_ok=True)
    started = STATE / f"{bundle_id}.started"
    if started.exists():
        blocked(original, quiet=True)  # 先把上一次的拦截存进长期记录
    started.write_text(subprocess.run(["date", "+%Y-%m-%d %H:%M:%S"], capture_output=True, text=True).stdout.strip())
    env = {"TZ": conf["tz"]} if conf.get("tz") else {}
    cwd = "/"
    sb = STATE / f"{bundle_id}.sb"
    if learn:
        sb.write_text(LEARN_PROFILE + "\n".join(never_rules()) + "\n")
        stamp = subprocess.run(["date", "+%Y-%m-%d %H:%M:%S"], capture_output=True, text=True).stdout.strip()
        (STATE / f"{bundle_id}.learn-start").write_text(stamp)
    else:
        sb.write_text(build_profile(app, bundle_id, rule, conf, mode, groups))
        if mode == "space":
            seed_space(bundle_id, rule)
            space = str(space_of(bundle_id))
            cwd = space
            env.update(HOME=space, CFFIXED_USER_HOME=space, TMPDIR=space + "/tmp/")
            if not rule.get("keep_prefs_service"):
                env["__CFPREFERENCES_AVOID_DAEMON"] = "1"  # 偏好设置直接读写模拟区域，不经系统服务
        elif sandboxed:
            # 副本没有苹果沙盒，让它把原来的容器当家目录，读写的就是原来那份数据
            home = Path(HOME, "Library/Containers", bundle_id, "Data")
            (home / "Library/Preferences").mkdir(parents=True, exist_ok=True)
            cwd = str(home)
            env.update(HOME=cwd, CFFIXED_USER_HOME=cwd, __CFPREFERENCES_AVOID_DAEMON="1")
        if not rule.get("keep_username"):
            env.update(USER="user", LOGNAME="user")
    if fake:
        lib = Path(app).parent / "libfakeloc.dylib"  # 放在副本旁边，规则已放行
        lib.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(ROOT / "libfakeloc.dylib", lib)
        env.update(KEKKAI_LAT=str(fake["lat"]), KEKKAI_LON=str(fake["lon"]))
    args = ["/usr/bin/sandbox-exec", "-f", str(sb), binary]
    if fake:  # 系统程序会丢掉 DYLD_ 变量，经 env 在最后一步交给软件
        args[3:3] = ["/usr/bin/env", f"DYLD_INSERT_LIBRARIES={lib}"]
    if any(Path(app, "Contents/Frameworks").glob("* Helper (GPU).app")):
        args.append("--no-sandbox")  # Electron／Chromium 自带沙盒不能嵌套
    args += rule.get("args", [])
    job = STATE / f"{label(bundle_id)}.plist"
    plistlib.dump({"Label": label(bundle_id), "ProgramArguments": args, "RunAtLoad": True, "KeepAlive": False,
                   "WorkingDirectory": cwd, "ProcessType": "Interactive", "LimitLoadToSessionType": "Aqua",
                   "StandardErrorPath": str(STATE / f"{bundle_id}.log"), "StandardOutPath": "/dev/null",
                   "EnvironmentVariables": env}, open(job, "wb"))
    subprocess.run(["launchctl", "bootout", f"gui/{UID}/{label(bundle_id)}"], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{UID}", str(job)], capture_output=True, text=True)
    return None if r.returncode == 0 else t(f"启动失败：{r.stderr.strip()}", f"Launch failed: {r.stderr.strip()}")


def stop(app):
    bundle_id, _ = info(app)
    subprocess.run(["launchctl", "bootout", f"gui/{UID}/{label(bundle_id)}"], capture_output=True)


def reset(app):
    """丢弃模拟区域里的全部改动，下次打开时重新从真实数据克隆。"""
    bundle_id, _ = info(app)
    stop(app)
    space = space_of(bundle_id)
    if space.parent == SPACES and space.exists():
        shutil.rmtree(space)


def list_apps():
    cache_path = STATE / "entitlements-cache.json"
    cache = json.loads(cache_path.read_text()) if cache_path.exists() else {}
    procs = subprocess.run(["ps", "-axo", "comm="], capture_output=True, text=True).stdout
    jobs = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    conf, out = settings(), []
    for base in ("/Applications", f"{HOME}/Applications"):
        for app in sorted(Path(base).glob("*.app")):
            try:
                bundle_id, exe = info(app)
            except (OSError, KeyError, plistlib.InvalidFileException):
                continue
            if bundle_id == "io.github.wjsgzz.kekkai":
                continue
            key = f"{app}:{Path(app, 'Contents/Info.plist').stat().st_mtime}"
            if "perm_keys" not in (cache.get(key) if isinstance(cache.get(key), dict) else {}):
                e = entitlements(str(app))
                cache[key] = {"sandboxed": bool(e.get("com.apple.security.app-sandbox")),
                              "perm_keys": [k for k in PERMISSIONS if e.get(k)]}
            inside = any(label(bundle_id) == ln.split("\t")[-1] and not ln.startswith("-") for ln in jobs.splitlines())
            c = conf.get(bundle_id, {})
            space = space_of(bundle_id)
            out.append({"id": bundle_id, "name": app.stem, "path": str(app), "sandboxed": cache[key]["sandboxed"],
                        "perms": [t(PERMISSIONS[k], PERMISSIONS_EN[k]) for k in cache[key]["perm_keys"]], "inside": inside, "running": f"{app}/Contents/MacOS/{exe}" in procs,
                        "tz": c.get("tz"), "mode": effective_mode(bundle_id, c, load_rule(bundle_id)),
                        "bringOld": bool(c.get("bring_old_data")), "block": blocked_devices(c), "location": c.get("location"), "allow": c.get("allow", []), "allowOpen": bool(c.get("allow_open")), "space": str(space), "hasSpace": space.exists()})
    STATE.mkdir(parents=True, exist_ok=True)
    cache_path.write_text(json.dumps(cache))
    print(json.dumps(out, ensure_ascii=False))


def main():
    a = sys.argv[1:]
    if a == ["list"]:
        return list_apps()
    if len(a) == 3 and a[0] == "set-tz":
        return set_tz(a[1], a[2])
    if len(a) == 3 and a[0] == "set-mode" and a[2] in ("space", "real"):
        return set_field(a[1], "mode", a[2])
    if len(a) == 3 and a[0] == "set-bring-old" and a[2] in ("on", "off"):
        return set_field(a[1], "bring_old_data", True if a[2] == "on" else "-")
    if len(a) == 4 and a[0] == "allow" and a[2] in ("add", "rm"):
        return set_allow(a[1], a[2], a[3])
    if a[:1] == ["set-location"] and (a[2:] == ["-"] or len(a) >= 4):
        return set_location(a[1], a[2:])
    if len(a) == 3 and a[0] == "set-open" and a[2] in ("on", "off"):
        return set_field(a[1], "allow_open", True if a[2] == "on" else "-")
    if len(a) == 4 and a[0] == "set-block" and a[2] in DEVICES and a[3] in ("on", "off"):
        return set_block(a[1], a[2], a[3] == "on")
    if a[:1] == ["never"] and (a[1:] == ["list"] or (len(a) == 3 and a[1] in ("add", "rm"))):
        return never_cmd(*a[1:])
    if len(a) == 2 and a[0] == "blocked":
        return blocked(a[1])
    if len(a) != 2 or a[0] not in ("run", "learn", "report", "stop", "reset"):
        sys.exit(__doc__)
    if a[0] == "stop":
        return stop(a[1])
    if a[0] == "reset":
        return reset(a[1])
    if a[0] == "report":
        return report(a[1])
    msg = run(a[1], learn=a[0] == "learn")
    if msg:
        print(msg)
        sys.exit(1)


if __name__ == "__main__":
    main()
