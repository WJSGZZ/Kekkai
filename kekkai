              "mac-address", "USB Serial Number", "kUSBSerialNumberString", "BatteryData", "EDID", "IODisplayEDID",
              "IODisplayEDIDOriginal", "DisplayAttributes"]


def model_name():
    out = subprocess.run(["system_profiler", "SPHardwareDataType"], capture_output=True, text=True).stdout
    m = re.search(r"(?:Model Name|型号名称)[:：]\s*(.+)", out)
    return m.group(1).strip() if m else "Mac"


def identity(bundle_id):
    """每个软件一套固定的假设备身份，第一次用时生成；软件之间各不相同，没法靠设备号把你串起来。"""
    data = settings()
    entry = data.setdefault(bundle_id, {})
    if not entry.get("identity"):
        chars = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789"  # 苹果序列号不用 I 和 O
        entry["identity"] = {"serial": "".join(secrets.choice(chars) for _ in range(10)),
                             "uuid": str(uuid.uuid4()).upper(), "seed": secrets.token_hex(8),
                             "name": model_name()}  # 电脑名用机型，和新 Mac 的默认名一样，不带你的名字
        save_settings(data)
    return entry["identity"]


def settings():
    p = STATE / "settings.json"
    return json.loads(p.read_text()) if p.exists() else {}


def save_settings(data):
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "settings.json").write_text(json.dumps(data, ensure_ascii=False, indent=1))


def set_field(bundle_id, key, value):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    if value == "-":
        entry.pop(key, None)
    else:
        entry[key] = value
    save_settings(data)


# 隔离开关：界面里的名字 → 设置里的键。没设置时用规则文件的默认，再没有就是最严
OPTIONS = {"localhost": "allow_localhost", "procinfo": "allow_procinfo", "keychain": "block_keychain", "clone": "clone"}


OPTION_DEFAULTS = {"block_keychain": True}  # 默认全部最严


def opt(rule, conf, key):
    return bool(conf[key]) if key in conf else bool(rule.get(key, OPTION_DEFAULTS.get(key, False)))


def set_tz(bundle_id, tz):
    if tz != "-" and not Path("/usr/share/zoneinfo", tz).is_file():
        sys.exit(t(f"未知时区：{tz}", f"Unknown time zone: {tz}"))
    set_field(bundle_id, "tz", tz)


def never_list():
    data = settings()
    return data.get("_never", DEFAULT_NEVER)


def never_cmd(action, path=None):
    items = list(never_list())
    if action == "add":
        real = str(Path(path).expanduser().resolve())
        if real not in items:
            items.append(real)
    elif action == "rm":
        real = str(Path(path).expanduser().resolve())
        items = [x for x in items if x != real and x != path]
    if action != "list":
        data = settings()
        data["_never"] = items
        save_settings(data)
    print(json.dumps(items, ensure_ascii=False))


def never_rules():
    # 放在规则最后，优先级高于任何放行
    items = [str(Path(p).resolve()) for p in never_list()]
    return ["(deny file-read* file-write* (with errno 2)", *[f"  (subpath {q(p)})" for p in items], ")"] if items else []


def space_of(bundle_id):
    return SPACES / bundle_id


def display_names(app):
    """App 的名字（含各语言）。Electron 等软件按名字建数据文件夹，如“微信开发者工具”。"""
    p = Path(app, "Contents")
    found = {plistlib.load(open(p / "Info.plist", "rb")).get(k) for k in ("CFBundleName", "CFBundleDisplayName")}
    for f in p.glob("Resources/*.lproj/InfoPlist.strings"):
        r = subprocess.run(["plutil", "-convert", "json", "-o", "-", str(f)], capture_output=True, text=True)
        if r.returncode == 0:
            d = json.loads(r.stdout)
            found |= {d.get("CFBundleName"), d.get("CFBundleDisplayName")}
    return sorted(n for n in found if isinstance(n, str) and n.strip() and "/" not in n and n != "Electron")


def nested_ids(app):
    """App 里附带的小程序和扩展，如 QQ 的 com.tencent.qqexdoc。"""
    ids = set()
    for p in Path(app, "Contents").rglob("Info.plist"):
        if p.parent.name == "Contents" and p.parent.parent.suffix in (".app", ".appex", ".xpc"):
            try:
                ids.add(plistlib.load(open(p, "rb"))["CFBundleIdentifier"])
            except Exception:
                pass
    return ids


def own_names(bundle_id, rule):
    return sorted({bundle_id, *rule.get("names", [])})


def import_container(bundle_id):
    """把原 App 沙盒容器里的数据用 APFS 克隆放进副本，替换副本现有数据。原 App 的数据不动。"""
    src = Path(HOME, "Library/Containers", bundle_id, "Data/Library")
    dst = space_of(bundle_id) / "Library"
    if not src.is_dir():
        return t("原 App 还没有数据。", "The original app has no data yet.")
    tmp = dst.with_name("Library.importing")
    shutil.rmtree(tmp, ignore_errors=True)
    r = subprocess.run(["/bin/cp", "-cR", str(src), str(tmp)], capture_output=True, text=True)
    if r.returncode:
        shutil.rmtree(tmp, ignore_errors=True)
        return copy_failed(r.stderr)
    if dst.exists():
        shutil.rmtree(dst)
    tmp.rename(dst)


def own_sources(app, bundle_id, rule):
    """它在资料库里的数据：按 ID（含附带的小程序）、名字、声明的群组容器认，和放行规则同一套认法。"""
    lib = Path(HOME, "Library")
    ids = sorted({*own_names(bundle_id, rule), *nested_ids(app)})
    pat = re.compile("^(" + "|".join(re.escape(n) for n in ids) + r")([-._].*)?$")
    found = []
    for base in OWN_BASES:
        if base == "Group Containers" or base in rule.get("skip_seed", []):  # 群组容器按声明认，下面单独加
            continue
        d = lib / base
        if d.is_dir():
            found += [p for p in d.iterdir() if pat.match(p.name) or base in NAME_BASES and p.name in display_names(app)]
    found += [lib / "Group Containers" / g for g in app_groups(app) if (lib / "Group Containers" / g).exists()]
    found += [Path(HOME, hp) for hp in rule.get("home_paths", []) if Path(HOME, hp).exists()]
    return found


def import_own(app, bundle_id, rule):
    """把它原来的数据用 APFS 克隆放进它的结界文件夹，替换那里的同名数据。原数据不动。"""
    space = space_of(bundle_id)
    for src in own_sources(app, bundle_id, rule):
        dst = space / src.relative_to(HOME)
        if dst.exists() or dst.is_symlink():
            shutil.rmtree(dst) if dst.is_dir() and not dst.is_symlink() else dst.unlink()
        dst.parent.mkdir(parents=True, exist_ok=True)
        r = subprocess.run(["/bin/cp", "-cR", str(src), str(dst)], capture_output=True, text=True)
        if r.returncode:
            return copy_failed(r.stderr)


def copy_failed(err):
    # macOS 保护其他 App 的容器（系统策略拒绝读，实测不弹授权框），要给结界“完全磁盘访问权限”
    if "Operation not permitted" in err:
        return t("macOS 不允许结界读取原 App 的数据。请在“系统设置 › 隐私与安全性 › 完全磁盘访问权限”中打开“结界”，然后重试。",
                 "macOS won't let Kekkai read the original app's data. Turn on Kekkai in System Settings › Privacy & Security › Full Disk Access, then try again.")
    return t(f"导入失败：{err.strip()[:200]}", f"Import failed: {err.strip()[:200]}")


def seed_space(app, bundle_id, rule, container=False):
    """首次进入时把软件原来的数据用 APFS 克隆放进它的结界文件夹，原数据不动。所有软件同一套做法。"""
    space = space_of(bundle_id)
    # 副本程序可能先建好了，看数据区里有没有真的数据
    fresh = not any(p.is_file() for p in (space / "Library").rglob("*")) if (space / "Library").exists() else True
    SPACES.mkdir(parents=True, exist_ok=True)
    os.chmod(SPACES, 0o777 | 0o1000) if SPACES.stat().st_uid == UID else None
    for d in SPACE_DIRS:
        (space / d).mkdir(parents=True, exist_ok=True)
    os.chmod(space, 0o700)
    for rel in rule.get("space_dirs", []):
        (space / rel).mkdir(parents=True, exist_ok=True)
    if fresh:
        # 自带苹果沙盒的软件，数据都在它的容器里；其他软件按 ID 和名字认
        import_container(bundle_id) if container else import_own(app, bundle_id, rule)


def private_keychain(bundle_id, real=False):
    """结界文件夹里它自己的钥匙串：它存的登录凭据留在这里，读不到你的钥匙串。
    家目录换到结界文件夹后，系统按新家目录里的偏好找钥匙串（实测），所以只改它自己的那份设置。
    文件不能叫 login.keychain-db，系统会特殊对待、解不开锁（实测）。real=True 时改指向你真实的钥匙串。"""
    space = space_of(bundle_id)
    kc = space / "Library/Keychains/kekkai.keychain-db"
    pw_file = STATE / f"{bundle_id}.keychain"
    env = {**os.environ, "HOME": str(space), "CFFIXED_USER_HOME": str(space), "__CFPREFERENCES_AVOID_DAEMON": "1"}
    sec = lambda *a: subprocess.run(["/usr/bin/security", *a], env=env, capture_output=True, text=True)
    if real:
        login = f"{HOME}/Library/Keychains/login.keychain-db"
        sec("list-keychains", "-d", "user", "-s", login)
        sec("default-keychain", "-d", "user", "-s", login)
        return
    if not kc.exists() or not pw_file.exists():
        kc.unlink(missing_ok=True)
        if kc.parent.is_symlink():
            kc.parent.unlink()  # 从苹果沙盒容器复制来的，是指向外面的链接，在结界里本来就失效
        kc.parent.mkdir(parents=True, exist_ok=True)
        pw_file.write_text(subprocess.run(["openssl", "rand", "-hex", "24"], capture_output=True, text=True).stdout.strip())
        pw_file.chmod(0o600)
        sec("create-keychain", "-p", pw_file.read_text(), str(kc))
        sec("set-keychain-settings", str(kc))  # 不自动上锁
    sec("list-keychains", "-d", "user", "-s", str(kc))
    sec("default-keychain", "-d", "user", "-s", str(kc))
    sec("unlock-keychain", "-p", pw_file.read_text(), str(kc))


def ancestors(path):
    return [str(p) for p in Path(path).parents if str(p) != "/"]


def blocked_devices(conf, injected=False):
    # 剪贴板：能注入的默认不挡服务，改为“能写、按粘贴才能读”；不能注入的做不到这一步，默认整个挡掉
    return [d for d in DEVICES if conf.get("block", [] if injected else DEFAULT_BLOCK).count(d)]


def clipboard_mode(conf, injected):
    """off 整个挡掉；paste 能写，你按 ⌘V 或点“粘贴”时才能读（要注入）；on 随便读写。"""
    if "clipboard" in blocked_devices(conf, injected):
        return "off"
    return "paste" if injected and conf.get("clipboard_read", "paste") == "paste" else "on"


def set_clipboard(bundle_id, mode):
    set_block(bundle_id, "clipboard", mode == "off")
    if mode != "off":
        set_field(bundle_id, "clipboard_read", "paste" if mode == "paste" else "always")


def set_location(bundle_id, args):
    if args == ["-"]:
        return set_field(bundle_id, "location", "-")
    lat, lon = float(args[0]), float(args[1])
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        sys.exit(t("经纬度超出范围", "Latitude or longitude out of range"))
    rest = args[2:]
    mars = rest[:1] == ["--mars"]  # 界面在中国大陆选点时已换算成 WGS-84，记下来以便地图上换回显示
    rest = rest[1:] if rest[:1] in (["--mars"], ["--wgs"]) else rest
    set_field(bundle_id, "location", {"lat": lat, "lon": lon, "name": " ".join(rest), "mars": mars})


def set_block(bundle_id, device, on):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    items = [d for d in entry.get("block", DEFAULT_BLOCK) if d != device] + ([device] if on else [])
    entry["block"] = sorted(items)
    save_settings(data)


def common_rules(rule, conf, mode="space"):
    L = [";; 不许借系统工具跑到结界外",
         "(deny process-exec", *[f"  (literal {q(x)})" for x in NO_EXEC], ")"]
    if not opt(rule, conf, "keep_username"):
        L += [";; 挡住目录服务，软件查不到真实用户名",
              "(deny mach-lookup", *[f"  (global-name {q(x)})" for x in DIRECTORY_SERVICES], ")"]
    if not opt(rule, conf, "keep_identity"):
        ids = HARDWARE_IDS + ([] if conf.get("inject") else DEVICE_IDS)
        L += [";; 挡住序列号、硬件 UUID、网卡地址等能认出这台 Mac 的值",
              "(deny iokit-get-properties (with errno 2) (iokit-property " + " ".join(q(x) for x in ids) + "))"]
        if not conf.get("inject"):
            # 开机时间、本次开机编号、磁盘服务给的分区 UUID 也能对上号；能注入的换成假的，不能注入的挡掉
            L += ['(deny sysctl-read (sysctl-name "kern.bootsessionuuid") (sysctl-name "kern.boottime"))',
                  '(deny mach-lookup (global-name "com.apple.DiskArbitration.diskarbitrationd"))']
    if not conf.get("inject"):
        # IPv4 的 ARP 条目系统已不给普通程序，IPv6 的邻居表仍带路由器的网卡地址，能认出你在哪个网络。
        # 只挡 IPv6 与全部协议的整表导出（1 dump、2 按标志、7 dump2）；网卡列表（3、6）照常，不影响联网
        L += [";; 看不到局域网邻居的网卡地址",
              '(deny sysctl-read (sysctl-name-regex #"^net\\.routetable\\.[0-9]+\\.(0|30)\\.(1|2|7)\\."))']
    if not conf.get("allow_open"):
        # 经系统拉起的软件不在结界里，挡住它就挡住了借别的软件逃出去的路；代价是不能用浏览器打开链接
        L += [";; 不许拉起其他软件、不许给其他软件发自动化指令", "(deny lsopen)", "(deny appleevent-send)"]
    # 运行中的软件列表来自 launchservicesd，挡住它图形软件就启动不了，所以只挡进程信息
    if not opt(rule, conf, "allow_procinfo"):
        # 进程表另有一条 sysctl 的路，只挡 process-info 挡不住（实测能列出全部进程和名字）；
        # 按编号查查得到自己也查得到别人，能注入的由注入库只放行自己，不能注入的整个挡掉
        procs = ['(sysctl-name "kern.proc.all")', *[f'(sysctl-name-prefix "kern.proc.{x}")' for x in ("uid", "ruid", "pgrp", "tty", "sid")]]
        procs += [] if conf.get("inject") else ['(sysctl-name-prefix "kern.proc.pid")']
        L += [";; 看不到其他进程", "(deny process-info* (target others))", "(deny process-info-listpids)",
              f"(deny sysctl-read {' '.join(procs)})"]
    if not opt(rule, conf, "allow_localhost"):
        # 本机上别的程序开的端口（代理面板、开发服务器、其他软件的本地接口）不让它碰；系统代理的端口留着，不然上不了网。
        # 它只能连分给它的那组端口：能注入的软件自己开端口时，注入库把端口挪进这组（见 inject.c）。
        # 沙盒规则只能写“任意地址”或“本机”，局域网设备交给 macOS 的“本地网络”权限
        start, count = conf.get("ports", (0, 0))
        L += [";; 不许连本机上其他程序的网络端口，只许连分给它的端口", '(deny network-outbound (remote ip "localhost:*"))',
              *[f'(allow network-outbound (remote ip "localhost:{p}"))' for p in [*proxy_ports(), *range(start, start + count)]]]
    if opt(rule, conf, "block_keychain") and mode != "space":
        # 原地运行的软件家目录就是你的，没法给它单独的钥匙串，只能整个挡住
        L += [";; 挡住钥匙串，代价是依赖钥匙串的登录会失效",
              '(deny mach-lookup (global-name "com.apple.securityd.xpc") (global-name "com.apple.SecurityServer") (global-name "com.apple.secd.keychain"))']
    for d in blocked_devices(conf, conf.get("inject")):
        L += DEVICES[d]
    return L


def proxy_ports():
    out = subprocess.run(["scutil", "--proxy"], capture_output=True, text=True).stdout
    return sorted({int(p) for p in re.findall(r"(?:HTTP|HTTPS|SOCKS)Port : (\d+)", out)})


PORT_RANGE, PORT_BLOCK = (20000, 40000), 32  # 每个软件分一组端口，各组不重叠


def busy_ports():
    """本机上已经有程序占着的端口（TCP 在监听的、UDP 绑定了的）。"""
    out = subprocess.run(["netstat", "-an"], capture_output=True, text=True).stdout
    return {int(m[1]) for line in out.splitlines() if line.startswith(("tcp", "udp")) and ("LISTEN" in line or line.startswith("udp"))
            for m in [re.search(r"[.:](\d+)\s", line.split(None, 4)[3] + " ")] if m}


def port_block(bundle_id):
    """分给它的端口：沿用上次的；启动前那组里有别的程序在占（它此时没在运行），就换一组。"""
    data = settings()
    busy = busy_ports()
    taken = {tuple(c["ports"])[0] for k, c in data.items() if k != bundle_id and isinstance(c, dict) and c.get("ports")}
    start = (data.get(bundle_id, {}).get("ports") or [0])[0]
    if start and not busy & set(range(start, start + PORT_BLOCK)):
        return start, PORT_BLOCK
    for s in range(PORT_RANGE[0], PORT_RANGE[1], PORT_BLOCK):
        if s not in taken and not busy & set(range(s, s + PORT_BLOCK)):
            set_field(bundle_id, "ports", [s, PORT_BLOCK])
            return s, PORT_BLOCK
    return 0, 0


def allowed_dirs(conf):
    return [str(Path(p).resolve()) for p in conf.get("allow", [])]


def set_allow(bundle_id, action, path):
    data = settings()
    entry = data.setdefault(bundle_id, {})
    real = str(Path(path).expanduser().resolve())
    items = [p for p in entry.get("allow", []) if p != real]
    entry["allow"] = items + [real] if action == "add" else items
    save_settings(data)


def app_groups(app):
    return entitlements(app).get("com.apple.security.application-groups", [])


def build_profile(app, bundle_id, rule, conf, mode, groups=()):
    L = ["(version 1)", "(allow default)", ";; 被挡的路径一律显示为不存在",
         "(deny file-read* file-write* (with errno 2)", *[f"  (subpath {q(b)})" for b in BLOCKED], ")",
         '(deny file-read-data (with errno 2) (literal "/Users"))']
    if not rule.get("shared_tmp"):
        # 共用临时、缓存文件夹只放行系统的和它自己的条目；临时文件改放它自己的文件夹
        mine = "|".join(re.escape(n) for n in [*own_names(bundle_id, rule), *nested_ids(app), "com.apple."])
        L += ["(deny file-read* file-write* (with errno 2)", f"  (subpath {q(USER_TEMP)}) (subpath {q(USER_CACHE)}))",
              *[f'(allow file-read* file-write* (regex #"^{re.escape(d)}/\\.?({mine})[^/]*(/.*)?$"))' for d in (USER_TEMP, USER_CACHE)],
              f"(allow file-read-metadata (literal {q(USER_TEMP)}) (literal {q(USER_CACHE)}) (literal {q(USER_TEMP + '/TemporaryItems')}))"]
        # 系统安全替换文件时建的临时文件夹，以软件显示名命名
        shown = "|".join(re.escape(n) for n in [*display_names(app), *own_names(bundle_id, rule)])
        L.append(f'(allow file-read* file-write* (regex #"^{re.escape(USER_TEMP)}/TemporaryItems/NSIRD_({shown})_[^/]+(/.*)?$"))')
    L += ["(deny file-read-data (with errno 2)", *[f"  (literal {q(p)})" for p in NO_LIST], ")"]
    system = [f"(subpath {q(x)})" for x in rule.get("system_paths", [])]
    system += [f'(regex #"{x.replace("^~", "^" + re.escape(HOME))}")' for x in rule.get("system_regex", [])]
    L.append(f"(allow file-read* (subpath {q(app)}) (subpath {q(str(LIBDIR))}))")
    # /usr/bin/git、clang 等只是转到 Xcode 命令行工具的壳，挡住开发工具目录它们就全失效
    dev = subprocess.run(["/usr/bin/xcode-select", "-p"], capture_output=True, text=True).stdout.strip()
    if dev:
        dev = next((a for a in ancestors(dev) if a.endswith(".app")), dev)  # xcodebuild 还要读 Xcode.app 里别的框架
        L += [f"(allow file-read-metadata {' '.join(f'(literal {q(a)})' for a in ancestors(dev))})", f"(allow file-read* (subpath {q(dev)}))"]
    if mode == "space":
        space = str(space_of(bundle_id))
        approved = allowed_dirs(conf)
        L += [";; 所有改动都落在模拟区域，另加你批准的文件夹",
              "(allow file-read-metadata", *[f"  (literal {q(p)})" for p in sorted({*ancestors(space), *(a for p in approved for a in ancestors(p))})],
              '  (literal "/Applications") (literal "/Volumes"))',
              "(allow file-read* file-write*", f"  (subpath {q(space)})", *[f"  (subpath {q(p)})" for p in approved], *["  " + s for s in system], ")"]
        # 打开项目时常先列出上一级找它（实测微信开发者工具），只给看名字，不给读内容
        L += [f"(allow file-read-data (literal {q(str(Path(p).parent))}))" for p in approved]
        # 软件存下的旧绝对路径要经过旧位置的链接（实测 QQ 的储存路径），只放行链接本身，指向的地方照常按上面判断
        if OLD_SPACES.is_symlink():
            L.append(f"(allow file-read-metadata (literal {q(str(OLD_SPACES))}))")
    else:
        names = own_names(bundle_id, rule)
        # 按 ID 放行 com.tencent.qq 和 com.tencent.qq.share 这类，不放行 com.tencent.qqmusic
        names = sorted({*names, *nested_ids(app)})
        own = [f'(regex #"^{re.escape(HOME)}/Library/([^/]+/)?{re.escape(n)}([-._][^/]*)?(/.*)?$")' for n in names]  # 沙盒正则把 [._-] 当范围，连字符要放最前
        # 按名字只在常见数据目录里放行同名文件夹，避免名字叫 Mail 的软件碰到 ~/Library/Mail
        bases = "|".join(re.escape(b) for b in NAME_BASES)
        own += [f'(regex #"^{re.escape(HOME)}/Library/({bases})/{re.escape(n)}(/.*)?$")' for n in display_names(app)]
        extra = [f"(subpath {q(os.path.join(HOME, x))})" for x in rule.get("home_paths", [])]
        extra += [f"(subpath {q(f'{HOME}/Library/Group Containers/{g}')})" for g in groups]
        approved = allowed_dirs(conf)
        parents = sorted({"/Users", HOME, f"{HOME}/Library", "/Applications", "/Volumes",
                          *(f"{HOME}/Library/{b}" for b in OWN_BASES), *ancestors(app),
                          *(a for p in approved for a in ancestors(p))})
        L += [";; 只放行它自己的数据和你批准的文件夹",
              "(allow file-read-metadata", *[f"  (literal {q(p)})" for p in parents], ")",
              "(allow file-read* file-write*", *["  " + o for o in own], *["  " + x for x in extra],
              *[f"  (subpath {q(p)})" for p in approved], *["  " + s for s in system], ")",
              *[f"(allow file-read-data (literal {q(str(Path(p).parent))}))" for p in approved],
              f"(allow file-read* (literal {q(HOME + '/.CFUserTextEncoding')}))",
              f"(allow file-read-metadata (subpath {q(HOME + '/Library/Keychains')}))"]
    if not opt(rule, conf, "block_keychain"):
        # 钥匙串文件藏起来系统会以为钥匙串丢了（实测弹“找不到钥匙串”）；读里面的密码仍要过系统自己的授权
        L.append(f"(allow file-read* file-write* (subpath {q(HOME + '/Library/Keychains')}))")
    # 输入法和键盘布局，打字要用
    L.append(f"(allow file-read* (subpath {q(HOME + '/Library/Input Methods')}) (subpath {q(HOME + '/Library/Keyboard Layouts')}))")
    # 模拟区域里没有旧数据，有的软件发现空的旧数据目录就要授权，让这一步看到“目录不存在”
    hide = [f"  (literal {q(os.path.join(space_of(bundle_id), x))})" for x in rule.get("space_hide_stat", []) if mode == "space"]
    if hide:
        L += ["(deny file-read-metadata (with errno 2)", *hide, ")"]
    return "\n".join(L + common_rules(rule, conf, mode) + never_rules()) + "\n"


def effective_mode(bundle_id, conf, rule):
    # 所有软件默认在自己的结界文件夹里运行。个别软件用“书签”记住数据文件夹的真实位置，搬走就失效（实测腾讯会议），规则里写 "mode": "real" 原地运行
    return conf.get("mode", rule.get("mode", "space"))


def label(bundle_id):
    return f"io.github.wjsgzz.kekkai.{bundle_id}"


LEARN_PROFILE = "(version 1)\n(allow default)\n(allow file-read* file-write* (with report))\n"
INTERESTING = (HOME + "/", "/Users/Shared", "/Volumes/", "/Applications/", "/private/tmp/")


def report(app):
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    start = (STATE / f"{bundle_id}.learn-start").read_text().strip()
    r = subprocess.run(["/usr/bin/log", "show", "--start", start, "--style", "compact", "--predicate",
                        'senderImagePath CONTAINS "Sandbox" AND eventMessage CONTAINS " allow file-"'],
                       capture_output=True, text=True, errors="replace")
    seen = {}
    for line in r.stdout.splitlines():
        m = re.search(r" allow file-(read|write)[^ ]* (/.*)$", line)
        if not m or m[2].startswith(app + "/") or not m[2].startswith(INTERESTING):
            continue
        parts = m[2].split("/")
        key = "/".join(parts[:7 if m[2].startswith(HOME + "/Library/") else 5])
        seen.setdefault(key, set()).add(m[1])
    lines = [f"{t('读写', 'R/W') if len(v) > 1 else (t('写', 'W') if 'write' in v else t('读', 'R'))}  {k}" for k, v in sorted(seen.items())]
    head = t(f"{Path(app).stem} 从 {start} 起碰过的外部路径（共 {len(lines)} 组，系统日志可能合并或遗漏）：",
             f"Outside paths {Path(app).stem} touched since {start} ({len(lines)} groups; the system log may merge or drop entries):")
    text = head + "\n" + "\n".join(lines) + "\n"
    out = STATE / f"{bundle_id}-report.txt"
    out.write_text(text)
    print(out)


# 去掉这些后才能用临时签名重签；苹果沙盒不能叠加，受限权限没有描述文件会被系统拒绝
STRIP = ("com.apple.security.app-sandbox", "com.apple.security.inherit", "com.apple.application-identifier",
         "com.apple.developer.", "keychain-access-groups")


def resign(bundle):
    ents = entitlements(bundle)
    kept = {k: v for k, v in ents.items() if not k.startswith(STRIP)}
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "entitlements.plist"
    plistlib.dump(kept, open(tmp, "wb"))
    r = subprocess.run(["codesign", "-f", "-s", "-", "--entitlements", str(tmp), bundle], capture_output=True, text=True)
    if r.returncode:
        sys.exit(t(f"重签名失败：{r.stderr.strip()}", f"Re-signing failed: {r.stderr.strip()}"))


def local_copy(app, bundle_id):
    """在模拟区域里放一份 APFS 克隆，去掉苹果沙盒和强化运行时后重签，原 App 不动。
    自带苹果沙盒的 App 再套一层会崩溃；虚拟定位要注入，也要用副本。"""
    SPACES.mkdir(parents=True, exist_ok=True)
    dst = space_of(bundle_id) / "Applications" / Path(app).name
    stamp = dst.parent / (Path(app).name + ".source")
    src_id = str(Path(app, "Contents/Info.plist").stat().st_mtime)
    if dst.exists() and stamp.exists() and stamp.read_text() == src_id:
        return str(dst)
    if dst.exists():
        shutil.rmtree(dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["cp", "-cR", app, str(dst)], check=True)
    files = [p for p in dst.joinpath("Contents").rglob("*") if not p.is_symlink()]
    bundles = [p for p in files if p.suffix in (".app", ".appex", ".xpc") and p.is_dir()]
    loose = [p for p in files if p.is_file() and os.access(p, os.X_OK) and p.parent.name != "MacOS"
             and any(k.startswith(STRIP) for k in entitlements(str(p)))]  # 如微信的 crashpad_handler
    for b in loose + sorted(bundles, key=lambda p: -len(p.parts)):  # 先签里层
        resign(str(b))
    resign(str(dst))
    stamp.write_text(src_id)
    return str(dst)


def verb(op):
    """操作的准确叫法。"""
    op = op.removeprefix("system:")
    names = {"file-read-metadata": ("读取属性", "Inspect"), "file-write-create": ("创建", "Create"), "file-write-unlink": ("删除", "Delete"),
             "mach-lookup": ("连接", "Connect to"), "network-outbound": ("连接", "Connect to"), "lsopen": ("启动", "Launch"),
             "appleevent-send": ("发送指令", "Send events to"), "process-info-listpids": ("列出", "List")}
    if op in names:
        return t(*names[op])
    if op.startswith("file-write-data"):
        return t("写入", "Write")
    if op.startswith("file-write"):
        return t("修改属性", "Modify")
    if op.startswith("file-read"):
        return t("读取", "Read")
    return t("读取信息", "Inspect") if op.startswith("process-info") else op


