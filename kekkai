                  "Keychains", "Caches/com.apple.", "Keyboard Layouts", "Input Methods")


def cat_name(key):
    return t(*CATS[key][:2])


def categorize(op, target, app="", bundle_id=""):
    """把一条拦截归类，返回 CATS 里的键。"""
    h = HOME + "/"
    target = re.sub(r"^remote:\*:", "localhost:", target)
    if op.startswith("system:"):
        return "macos"
    if app and (target == app or target.startswith(app + "/")):
        return "bundle"
    if app and target.startswith(str(SPACES) + "/") and "/Applications/" + Path(app).name in target:
        return "bundle"  # 它自己的副本
    if bundle_id and target.startswith(f"{h}Library/Containers/{bundle_id}/"):
        return "owndata"
    if op.startswith("process-info"):
        return "sysproc" if target in SYSTEM_PROCS else "proc"
    if op in ("lsopen", "appleevent-send"):
        return "launch"
    if op.startswith("network"):
        # 临时端口（49152 起）多半是它自己的子进程开的；固定端口是别的程序的服务
        port = target.rsplit(":", 1)[-1]
        return "ownport" if port.isdigit() and int(port) >= 49152 else "localhost"
    if op == "mach-lookup":
        if "opendirectoryd" in target:
            return "account"
        return "clipboard" if "pasteboard" in target else "service"
    if target in ("/Applications", h + "Applications") or target.startswith(("/Applications/", "/System/Applications/", h + "Applications/")):
        return "apps"
    if target.startswith(tuple(h + d for d in ("Desktop", "Documents", "Downloads", "Pictures", "Movies", "Music", "Library/Mobile Documents"))):
        return "personal"
    if "QuarantineEvents" in target:
        return "downloads"
    if target.startswith(h + "Library/"):
        rel = target[len(h + "Library/"):]
        # 上层文件夹只查属性，是系统框架在建自己的位置；列出内容或进到别人的文件夹才算越权
        if rel.startswith(SYSTEM_LIBRARY) or "/" not in rel and not op.startswith("file-read-data"):
            return "sysfiles"
        return "appdata"
    if target == HOME:
        return "homeroot"
    if target.startswith(h + "."):
        return "hidden"
    if target in ("/Volumes/Recovery", "/Volumes/Preboot", "/Volumes/VM", "/Volumes/Data"):
        return "sysvol"
    if target.startswith("/Volumes/"):
        return "disk"
    if target in (USER_TEMP, USER_CACHE) or target == str(Path(USER_TEMP).parent):
        return "apptemp"  # 列出共用临时文件夹，看得到所有软件的东西
    if target.startswith((USER_TEMP + "/TemporaryItems", USER_TEMP + "/scoped_dir")) or bundle_id and target.startswith((USER_TEMP, USER_CACHE)) and bundle_id in target:
        return "temp"
    if target.startswith((USER_TEMP, USER_CACHE)):
        return "apptemp"
    if target in NO_LIST or target.startswith(("/Library/", "/opt/", "/usr/local/")):
        return "installs"
    if target == str(SPACES) or target.startswith(str(SPACES) + "/"):
        return "spaces"
    if target.startswith(("/private/tmp", "/Users/Shared")):
        return "sharedtmp"
    if target.startswith(h):
        return "home"
    return "other"


def now():
    return subprocess.run(["date", "+%Y-%m-%d %H:%M:%S"], capture_output=True, text=True).stdout.strip()


def denials(app, start):
    """系统日志里这个软件（含附带的小程序）从 start 起被沙盒拒绝的请求：[(时间, 操作, 对象)]。"""
    # 按 MacOS 文件夹里的文件认进程：有的辅助程序 Info.plist 不写 CFBundleExecutable（实测微信开发者工具的 Helper）
    exes = {f.name for d in [Path(app, "Contents/MacOS"), *Path(app, "Contents").rglob("Contents/MacOS")] if d.is_dir() for f in d.iterdir()}
    r = subprocess.run(["/usr/bin/log", "show", "--start", start, "--style", "compact",
                        "--predicate", 'senderImagePath CONTAINS "Sandbox" AND eventMessage CONTAINS " deny("'],
                       capture_output=True, text=True, errors="replace")
    out = []
    for line in r.stdout.splitlines():
        m = re.search(r"(Sandbox|System Policy): (.+?)\(\d+\) deny\(\d+\) (\S+) (.*)$", line)
        if not m or m[2] not in exes:
            continue
        op, target = ("system:" if m[1] == "System Policy" else "") + m[3], m[4].strip()
        if op.startswith("process-info"):
            target = re.sub(r"\(\d+\)", "", re.sub(r"^others \[|\]$", "", target))
        if op.startswith("network"):
            target = re.sub(r"^remote:\*:", "localhost:", target)
        out.append((line[:19], op, target))
    return out


def grant_kind(op, target):
    """这条请求能怎么放行：folder 批准路径，open 允许打开其他软件，clipboard 解除剪贴板禁止。"""
    if op.startswith("system:"):
        return ""
    if op.startswith("file-") and target.startswith("/"):
        # 这些是很多软件共用的上层文件夹，放行就等于放出别人的数据
        lib = Path(HOME, "Library")
        shared = {"/", "/Users", HOME, "/Applications", "/Volumes", "/private/tmp", "/Users/Shared", str(lib),
                  USER_TEMP, USER_CACHE, str(Path(USER_TEMP).parent), *NO_LIST}
        p = Path(target)
        mixed = str(p.parent) in (USER_TEMP, USER_CACHE) or p.parent == lib or str(p).startswith(USER_TEMP + "/TemporaryItems")
        return "" if str(p) in shared or mixed else "folder"
    if op in ("lsopen", "appleevent-send"):
        return "open"
    if op.startswith("network"):
        return "localhost"
    return "clipboard" if "pasteboard" in target else ""


def trial(app, wait=40):
    """试运行：按结界的最小权限打开，看它能不能活下来，列出它被拒绝的请求。输出 JSON 给界面用。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    stop(app)  # 改了放行后再试，要先关掉上一次的
    for _ in range(10):
        if subprocess.run(["launchctl", "print", f"gui/{UID}/{label(bundle_id)}"], capture_output=True).returncode:
            break
        subprocess.run(["sleep", "1"])
    msg = run(app)
    if msg:
        return print(json.dumps({"error": msg}, ensure_ascii=False))
    start = (STATE / f"{bundle_id}.started").read_text().strip()
    binary = (STATE / f"{bundle_id}.binary").read_text()
    log_file = STATE / f"{bundle_id}.log"
    log_from = log_file.stat().st_size if log_file.exists() else 0
    exited_at = None
    for _ in range(wait):
        subprocess.run(["sleep", "1"])
        if subprocess.run(["pgrep", "-f", "^" + re.escape(binary)], capture_output=True).returncode:
            exited_at = now()
            break
    subprocess.run(["sleep", "2"])  # 等系统日志写完
    events = denials(app, start)
    code = re.search(r"last exit code = (\S+)", subprocess.run(
        ["launchctl", "print", f"gui/{UID}/{label(bundle_id)}"], capture_output=True, text=True).stdout)
    decisions = settings().get(bundle_id, {}).get("decided", {})
    seen, items = set(), []
    for when, op, target in events:
        key = f"{op} {target}"
        if key in seen:
            continue
        seen.add(key)
        cat = categorize(op, target, app, bundle_id)
        items.append({"key": key, "decision": decisions.get(key), "op": op, "target": target, "verb": verb(op), "category": cat_name(cat), "time": when,
                      "count": sum(1 for e in events if e[1] == op and e[2] == target),
                      "suspicious": cat in SUSPICIOUS, "normal": cat in NORMAL, "grant": grant_kind(op, target),
                      # 退出前几秒内被拒的，最可能是它退出的原因
                      "suspect": op.startswith("system:") or bool(exited_at) and when >= exited_at[:17] + "00" and cat not in NORMAL})
    blocked(app, quiet=True)
    # 软件还活着不代表正常，它可能弹了报错；把它自己日志里的报错也带上
    errors = []
    if log_file.exists():
        with open(log_file, errors="replace") as f:
            f.seek(log_from)
            for ln in f:
                if re.search(r"EPERM|EACCES|FATAL|Uncaught|Traceback|Exception|operation not permitted", ln, re.I) and len(errors) < 6:
                    errors.append(ln.strip()[:240])
    system_denied = any(i["op"].startswith("system:") for i in items)
    print(json.dumps({"errors": errors, "systemDenied": system_denied, "alive": exited_at is None, "exitCode": code[1] if code and exited_at else None,
                      "seconds": wait, "items": items}, ensure_ascii=False))


def decide(bundle_id, choice, key):
    """记下你对一条请求的决定；允许时顺带放行。"""
    op, target = key.split(" ", 1)
    if choice == "allow":
        kind = grant_kind(op, target)
        if kind == "folder":
            set_allow(bundle_id, "add", target)
        elif kind == "open":
            set_field(bundle_id, "allow_open", True)
        elif kind == "localhost":
            set_field(bundle_id, "allow_localhost", True)
        elif kind == "clipboard":
            set_block(bundle_id, "clipboard", False)
    data = settings()
    data.setdefault(bundle_id, {}).setdefault("decided", {})[key] = choice
    save_settings(data)


def job_state(bundle_id):
    """(是否在运行, 上次退出码)。"""
    out = subprocess.run(["launchctl", "print", f"gui/{UID}/{label(bundle_id)}"], capture_output=True, text=True).stdout
    code = re.search(r"last exit (?:code|reason) = (\S+)", out)
    return "state = running" in out, code[1] if code else None


def blocked(app, quiet=False, as_json=False):
    """从系统日志里取出结界拦下的请求，并入这个软件的长期记录。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    start_file = STATE / f"{bundle_id}.started"
    history_file = STATE / f"{bundle_id}-blocked.json"
    history = json.loads(history_file.read_text()) if history_file.exists() else {}
    if start_file.exists():
        cursor = now()  # 先记下时间再查，查的过程中新来的下次再取
        for when, op, target in denials(app, start_file.read_text().strip()):
            e = history.setdefault(f"{op} {target}", {"first": when, "count": 0})
            e["last"], e["count"] = when, e["count"] + 1
        history_file.write_text(json.dumps(history, ensure_ascii=False, indent=1))
        start_file.write_text(cursor)
    if as_json:
        return print(json.dumps(log_status(app, bundle_id, history), ensure_ascii=False))
    groups = {}
    for key, e in history.items():
        op, target = key.split(" ", 1)
        groups.setdefault(categorize(op, target, app, bundle_id), []).append((f"{verb(op)}  {target}", e))
    lines = [t(f"{Path(app).stem} 被结界拦下的请求（同一请求系统日志只记一部分，次数偏少）", f"Requests Kekkai blocked for {Path(app).stem} (the system log keeps only some repeats, so counts run low)"), ""]
    for cat, items in sorted(groups.items(), key=lambda g: -sum(e["count"] for _, e in g[1])):
        tag = t("　常规", "  Routine") if cat in NORMAL else t("　越权", "  Overreach") if cat in SUSPICIOUS else t("　留意", "  Worth a look")
        lines.append(f"## {cat_name(cat)}（{len(items)}）{tag}" if isChinese() else f"## {cat_name(cat)} ({len(items)}){tag}")
        for target, e in sorted(items, key=lambda x: -x[1]["count"])[:40]:
            lines.append(f"  {e['count']:>4}×  {target.replace(HOME, '~')}   {e['last']}")
        lines.append("")
    if not history:
        lines.append(t("还没有记录。在结界中打开它用一会儿再来看。", "Nothing yet. Open it in Kekkai, use it for a while, then check again."))
    out = STATE / f"{bundle_id}-blocked.txt"
    out.write_text("\n".join(lines) + "\n")
    if not quiet:
        print(out)


def log_status(app, bundle_id, history):
    """给界面的拦截记录：这次运行的状态、它自己日志里的报错、每条被拦请求和你的决定。"""
    merged = {}  # 旧记录把本机端口写成 remote:*:端口，和新写法合并
    for key, e in history.items():
        k = re.sub(r" remote:\*:", " localhost:", key)
        m = merged.setdefault(k, {"first": e["first"], "count": 0, "last": e["last"]})
        m["count"] += e["count"]
        m["last"] = max(m["last"], e["last"])
    history = merged
    running, code = job_state(bundle_id)
    run_start = (STATE / f"{bundle_id}.run-start").read_text().strip() if (STATE / f"{bundle_id}.run-start").exists() else ""
    exited_file = STATE / f"{bundle_id}.exited"
    if run_start and not running and not exited_file.exists():
        exited_file.write_text(now())  # 界面开着时每几秒查一次，退出时间误差就是这几秒
    exited = exited_file.read_text().strip() if run_start and not running else ""
    seconds = None
    if exited and not (STATE / f"{bundle_id}.stopped").exists():
        to = lambda x: datetime.strptime(x[:19], "%Y-%m-%d %H:%M:%S")
        seconds = int((to(exited) - to(run_start)).total_seconds())
    errors, log_file, pos_file = [], STATE / f"{bundle_id}.log", STATE / f"{bundle_id}.logpos"
    if log_file.exists() and pos_file.exists():
        with open(log_file, errors="replace") as f:
            f.seek(int(pos_file.read_text() or 0))
            for ln in f:
                if re.search(r"EPERM|EACCES|FATAL|Uncaught|Traceback|Exception|operation not permitted", ln, re.I) and len(errors) < 6:
                    errors.append(ln.strip()[:240])
    decisions = settings().get(bundle_id, {}).get("decided", {})
    crashed = seconds is not None and seconds < 60  # 被停止的不算
    items = []
    for key, e in history.items():
        op, target = key.split(" ", 1)
        cat = categorize(op, target, app, bundle_id)
        target = re.sub(r"^remote:\*:", "localhost:", target)
        items.append({"key": key, "decision": decisions.get(key), "op": op, "target": target, "verb": verb(op), "category": cat_name(cat),
                      "count": e["count"], "last": e["last"], "recent": bool(run_start) and e["last"] >= run_start,
                      "suspicious": cat in SUSPICIOUS, "normal": cat in NORMAL, "level": CATS[cat][2], "grant": grant_kind(op, target)})
        r = items[-1]  # 等你决定的：可能真需要的；打听类的不当成需要
        # 只在它异常退出时，把退出前被挡、又能放行的请求列出来让你决定；平时都折在分组里
        r["ask"] = crashed and r["recent"] and bool(r["grant"]) and not r["normal"] and (cat in ASKS or cat == "appdata")
    # 从网上下载、没经苹果公证的软件，macOS 的门禁在启动时就拦下（实测 OS_REASON_EXEC）；要不要放行是你的决定
    quarantined = subprocess.run(["xattr", "-p", "com.apple.quarantine", app], capture_output=True).returncode == 0
    gatekeeper = bool(exited) and code == "OS_REASON_EXEC" and quarantined
    # 退出码 173 是 App Store 软件要求重新校验购买凭证，重签的副本过不了
    receipt = bool(exited) and code == "173"
    return {"running": running, "gatekeeper": gatekeeper, "receipt": receipt, "started": run_start or None, "exited": exited or None, "seconds": seconds,
            "exitCode": code if exited else None, "errors": errors, "items": items}


def isChinese():
    return os.environ.get("KEKKAI_LANG", "zh") == "zh"


def run(app, learn=False):
    app = original = str(Path(app).resolve())
    bundle_id, exe = info(app)
    sandboxed = bool(entitlements(app).get("com.apple.security.app-sandbox"))
    rule, conf = load_rule(bundle_id), settings().get(bundle_id, {})
    fake = conf.get("location")
    groups = app_groups(app)
    # 虚拟定位和设备伪装要注入，原版的强化运行时不允许，用去掉强化运行时的副本
    if sandboxed or (fake or opt(rule, conf, "clone")) and not injectable(app):
        app = local_copy(app, bundle_id)
    binary = f"{app}/Contents/MacOS/{exe}"
    if subprocess.run(["pgrep", "-f", "^" + re.escape(binary)], capture_output=True).returncode == 0:
        return t(f"{Path(app).stem} 正在运行，请先退出。", f"{Path(app).stem} is already running. Quit it completely first.")
    # 苹果的“系统策略”只许原签名的软件进它的容器，重签的副本进不去，只能用自己的一份数据（实测 EPERM）
    mode = "space" if sandboxed else effective_mode(bundle_id, conf, rule)
    ports = (0, 0) if learn or opt(rule, conf, "allow_localhost") else port_block(bundle_id)
    conf = {**conf, "ports": list(ports), "inject": not learn and injectable(app)}
    STATE.mkdir(parents=True, exist_ok=True)
    started = STATE / f"{bundle_id}.started"
    if started.exists():
        blocked(original, quiet=True)  # 先把上一次的拦截存进长期记录
    started.write_text(now())
    (STATE / f"{bundle_id}.run-start").write_text(started.read_text())
    (STATE / f"{bundle_id}.exited").unlink(missing_ok=True)
    (STATE / f"{bundle_id}.stopped").unlink(missing_ok=True)
    log_file = STATE / f"{bundle_id}.log"
    (STATE / f"{bundle_id}.logpos").write_text(str(log_file.stat().st_size if log_file.exists() else 0))
    (STATE / f"{bundle_id}.binary").write_text(binary)
    if not original.startswith(("/Applications/", f"{HOME}/Applications/")):
        data = settings()  # 不在应用程序文件夹里的软件，记下来让它留在列表里
        data["_apps"] = sorted({*data.get("_apps", []), original})
        save_settings(data)
    env = {"TZ": conf["tz"]} if conf.get("tz") else {}
    cwd = "/"
    sb = STATE / f"{bundle_id}.sb"
    if learn:
        sb.write_text(LEARN_PROFILE + "\n".join(never_rules()) + "\n")
        stamp = subprocess.run(["date", "+%Y-%m-%d %H:%M:%S"], capture_output=True, text=True).stdout.strip()
        (STATE / f"{bundle_id}.learn-start").write_text(stamp)
    else:
        sb.write_text(build_profile(app, bundle_id, rule, conf, mode, groups))
        if mode == "space":
            seed_space(original, bundle_id, rule, container=sandboxed)
            space = str(space_of(bundle_id))
            cwd = space
            env.update(HOME=space, CFFIXED_USER_HOME=space, TMPDIR=space + "/tmp/", MAC_CHROMIUM_TMPDIR=space + "/tmp/")
            if not rule.get("keep_prefs_service"):
                env["__CFPREFERENCES_AVOID_DAEMON"] = "1"  # 偏好设置直接读写模拟区域，不经系统服务
                private_keychain(bundle_id, real=not opt(rule, conf, "block_keychain"))
        if not opt(rule, conf, "keep_username"):
            env.update(USER="user", LOGNAME="user")
    if not learn and not rule.get("shared_tmp") and mode != "space":
        tmp = Path(HOME, "Library/Caches", bundle_id, "kekkai-tmp")  # 在它自己的文件夹里
        tmp.mkdir(parents=True, exist_ok=True)
        env["TMPDIR"] = env["MAC_CHROMIUM_TMPDIR"] = str(tmp) + "/"  # Chromium 内核不认 TMPDIR
    libs = []
    if not learn and injectable(app):
        if mode == "space" and not opt(rule, conf, "keep_username"):
            env["KEKKAI_HOME"] = env["HOME"]  # 问用户名时答 user，不必放开系统查询
        if not opt(rule, conf, "keep_identity"):
            i = identity(bundle_id)
            env.update(KEKKAI_SERIAL=i["serial"], KEKKAI_UUID=i["uuid"], KEKKAI_SEED=i["seed"], KEKKAI_NAME=i["name"])
        if ports[1]:
            # 它要开的端口挪进分给它的那组；挪过的记在这个文件里，它的各个进程连原端口时照着换
            portmap = Path(env.get("TMPDIR", "/private/tmp/"), ".kekkai-ports")
            portmap.parent.mkdir(parents=True, exist_ok=True)
            portmap.write_text("")
            env.update(KEKKAI_PORTS=f"{ports[0]}:{ports[1]}", KEKKAI_PORTMAP=str(portmap))
        if clipboard_mode(conf, True) == "paste":
            env["KEKKAI_PASTE"] = "1"
        if not opt(rule, conf, "allow_procinfo"):
            env["KEKKAI_PROCS"] = "1"
        if "KEKKAI_HOME" in env or "KEKKAI_SEED" in env or "KEKKAI_PORTS" in env or "KEKKAI_PASTE" in env or "KEKKAI_PROCS" in env:
            libs.append("libkekkai.dylib")
    if fake:
        libs.append("libfakeloc.dylib")
        env.update(KEKKAI_LAT=str(fake["lat"]), KEKKAI_LON=str(fake["lon"]))
    LIBDIR.mkdir(parents=True, exist_ok=True)
    for name in libs:
        # 先写新文件再替换：原地覆盖已签名的库，系统会按旧的签名缓存把加载它的进程杀掉（实测 OS_REASON_CODESIGNING）
        shutil.copy(ROOT / name, LIBDIR / f".{name}.new")
        os.replace(LIBDIR / f".{name}.new", LIBDIR / name)
    args = ["/usr/bin/sandbox-exec", "-f", str(sb), binary]
    if libs:  # 系统程序会丢掉 DYLD_ 变量，经 env 在最后一步交给软件
        args[3:3] = ["/usr/bin/env", "DYLD_INSERT_LIBRARIES=" + ":".join(str(LIBDIR / n) for n in libs)]
    if any(Path(app, "Contents/Frameworks").glob("* Helper (GPU).app")):
        args.append("--no-sandbox")  # Electron／Chromium 自带沙盒不能嵌套
    args += rule.get("args", [])
    job = STATE / f"{label(bundle_id)}.plist"
    plistlib.dump({"Label": label(bundle_id), "ProgramArguments": args, "RunAtLoad": True, "KeepAlive": False,
                   "WorkingDirectory": cwd, "ProcessType": "Interactive", "LimitLoadToSessionType": "Aqua",
                   "StandardErrorPath": str(STATE / f"{bundle_id}.log"), "StandardOutPath": "/dev/null",
                   "EnvironmentVariables": env}, open(job, "wb"))
    subprocess.run(["launchctl", "bootout", f"gui/{UID}/{label(bundle_id)}"], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{UID}", str(job)], capture_output=True, text=True)
    return None if r.returncode == 0 else t(f"启动失败：{r.stderr.strip()}", f"Launch failed: {r.stderr.strip()}")


def stop(app):
    bundle_id, _ = info(app)
    if job_state(bundle_id)[0]:
        (STATE / f"{bundle_id}.stopped").write_text(now())  # 是结界或你停的，不算它自己退出
    subprocess.run(["launchctl", "bootout", f"gui/{UID}/{label(bundle_id)}"], capture_output=True)


TUNABLE = ["allow_localhost", "allow_procinfo", "allow_open"]
TUNE_CAT = {"ownport": "allow_localhost", "localhost": "allow_localhost", "proc": "allow_procinfo", "launch": "allow_open"}


def tune(app, wait=30):
    """第一次在结界中打开时在后台试：可选权限全关能撑过 wait 秒就结束；不行就找出缺的是哪一项，只开那一项。
    先按退出前被挡的请求找；系统日志不一定记下（实测秒退的程序没留日志），找不到就全开再逐项关回去试。
    只看得出“能不能启动”；登录、粘贴这类功能坏没坏，要你自己用了才知道。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    stopped = STATE / f"{bundle_id}.stopped"

    def survives(first=False):
        """运行一次，撑过 wait 秒返回 True，提前退出返回 False，被你停掉返回 None。"""
        if not first:
            stop(app)
            stopped.unlink(missing_ok=True)
            if run(app):
                return False
        for _ in range(wait):
            subprocess.run(["sleep", "1"])
            if not job_state(bundle_id)[0]:
                return None if stopped.exists() else False
        return True

    def setting(keys):
        for k in TUNABLE:
            set_field(bundle_id, k, True if k in keys else "-")

    start = (STATE / f"{bundle_id}.run-start").read_text().strip()
    ok = survives(first=True)
    needed = []
    if ok is False:
        subprocess.run(["sleep", "2"])  # 等系统日志写完
        guess = sorted({TUNE_CAT[c] for c in (categorize(op, tg, app, bundle_id) for _, op, tg in denials(app, start)) if c in TUNE_CAT})
        if guess:
            setting(guess)
            ok = survives()
            needed = guess if ok else []
        if not ok and ok is not None:
            setting(TUNABLE)
            ok = survives()
            if ok:
                needed = list(TUNABLE)
                for k in TUNABLE:  # 逐项关回去，关了就退出的才是必需的
                    setting([x for x in needed if x != k])
                    r = survives()
                    if r is None:
                        break
                    if r:
                        needed.remove(k)
                setting(needed)
                if survives() is False:
                    setting(TUNABLE)
                    needed = list(TUNABLE)
                    survives()
            else:
                setting([])  # 全开也不行，原因不在这几项；交给拦截记录里的文件请求
                needed = []
    data = settings()
    data.setdefault(bundle_id, {})["tuned"] = now()
    data[bundle_id]["auto_enabled"] = needed
    save_settings(data)


def add(app, wait=20):
    """添加就是第一次试运行：在结界里撑得住才加进列表，撑不住说明原因、不加。顺带找出它离不开的权限。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    space, had_conf = space_of(bundle_id), bundle_id in settings()
    had_space = space.exists()

    def result(ok, reason=""):
        if not ok:  # 没加进来就不留下这次试运行新建的结界文件夹和设置
            stop(app)
            if not had_space and space.exists():
                shutil.rmtree(space, ignore_errors=True)
            if not had_conf:
                data = settings()
                data.pop(bundle_id, None)
                save_settings(data)
        if ok:
            data = settings()
            data["_added"] = sorted({*data.get("_added", []), app})
            save_settings(data)
        needed = settings().get(bundle_id, {}).get("auto_enabled", []) if ok else []
        print(json.dumps({"ok": ok, "reason": reason, "autoEnabled": needed}, ensure_ascii=False))

    msg = run(app)
    if msg:
        return result(False, msg)
    tune(app, wait)
    if job_state(bundle_id)[0]:
        return result(True)
    if (STATE / f"{bundle_id}.stopped").exists():
        return result(False, t("试运行已停止，未添加。", "The trial run was stopped, so it wasn't added."))
    s = log_status(app, bundle_id, {})
    return result(False, failure_reason(bundle_id, s))


def failure_reason(bundle_id, s):
    """试运行失败的原因，一句话：能分清的说清楚，分不清的照实说退出码。"""
    out = subprocess.run(["launchctl", "print", f"gui/{UID}/{label(bundle_id)}"], capture_output=True, text=True).stdout
    signal = re.search(r"last terminating signal = ([^\n]+)", out)
    if s["receipt"]:
        return t("App Store 付费软件会校验购买凭证，结界里的副本通不过。", "Paid App Store apps check their purchase receipt, and the copy in Kekkai can't pass it.")
    if s["gatekeeper"]:
        return t("未经 Apple 公证，macOS 拦下了它。先在结界外打开一次并允许，再添加。",
                 "macOS blocked it because it isn't notarized. Open it once outside Kekkai and allow it, then add it again.")
    if s["exitCode"] == "OS_REASON_CODESIGNING":
        return t("代码签名校验未通过，macOS 不许它在结界里运行。", "It failed a code signature check, so macOS won't run it in Kekkai.")
    if signal:
        return t(f"启动后崩溃（{signal[1].strip()}），打开全部权限也一样。", f"It crashed after starting ({signal[1].strip()}), even with every permission on.")
    detail = s["errors"][0] if s["errors"] else ""
    return (t(f"启动后自行退出（退出码 {s['exitCode']}），打开全部权限也一样。", f"It quit on its own (exit code {s['exitCode']}), even with every permission on.")
            + ("\n" + detail if detail else ""))

def remove(app):
    """从列表里拿掉；它的结界文件夹和设置留着，以后再添加接着用。"""
    app = str(Path(app).resolve())
    data = settings()
    data["_added"] = [p for p in data.get("_added", []) if p != app]
    save_settings(data)


def make_launcher(app, name=None):
    """在“应用程序”里做一个从结界打开它的图标，放进程序坞或用聚焦搜索都能用。"""
    app = str(Path(app).resolve())
    bundle_id, _ = info(app)
    name = name or Path(app).stem
    # 放进系统的“应用程序”，和其他软件在一起；没有写入权限（非管理员）才放个人的 ~/Applications
    apps = Path("/Applications") if os.access("/Applications", os.W_OK) else Path(HOME, "Applications")
    dst = apps / (t(f"{name} 结界", f"{name} Kekkai") + ".app")  # 后缀让它在列表里紧挨着原版
    shutil.rmtree(dst, ignore_errors=True)
    (dst / "Contents/MacOS").mkdir(parents=True)
    exe = dst / "Contents/MacOS/launch"
    exe.write_text(f"#!/bin/sh\nexec {q(str(ROOT / 'kekkai'))} run {q(app)}\n")
    exe.chmod(0o755)
    plistlib.dump({"CFBundleIdentifier": f"io.github.wjsgzz.kekkai.launch.{bundle_id}", "CFBundleExecutable": "launch",
                   "CFBundleName": dst.stem, "CFBundlePackageType": "APPL", "LSUIElement": True}, open(dst / "Contents/Info.plist", "wb"))
    print(dst)


def reset(app):
    """丢弃模拟区域里的全部改动，下次打开时重新从真实数据克隆。"""
    bundle_id, _ = info(app)
    stop(app)
    space = space_of(bundle_id)
    if space.parent == SPACES and space.exists():
        shutil.rmtree(space)


def list_apps():
    cache_path = STATE / "entitlements-cache.json"
    cache = json.loads(cache_path.read_text()) if cache_path.exists() else {}
    procs = subprocess.run(["ps", "-axo", "comm="], capture_output=True, text=True).stdout
    jobs = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    conf, out = settings(), []
    added = set(conf.get("_added", []))
    extra = [Path(p) for p in conf.get("_apps", []) if Path(p).exists()]
    for base in ("/Applications", f"{HOME}/Applications", None):
        for app in (sorted(Path(base).glob("*.app")) if base else extra):
            try:
                bundle_id, exe = info(app)
            except (OSError, KeyError, plistlib.InvalidFileException):
                continue
            if bundle_id.startswith("io.github.wjsgzz.kekkai"):
                continue
            key = f"{app}:{Path(app, 'Contents/Info.plist').stat().st_mtime}"
            if "perm_keys" not in (cache.get(key) if isinstance(cache.get(key), dict) else {}):
                e = entitlements(str(app))
                cache[key] = {"sandboxed": bool(e.get("com.apple.security.app-sandbox")),
                              "perm_keys": [k for k in PERMISSIONS if e.get(k)]}
            if "inj" not in cache[key]:  # 自带苹果沙盒的软件跑的是重签的副本，副本能注入
                cache[key]["inj"] = cache[key]["sandboxed"] or injectable(str(app))
            inside = any(label(bundle_id) == ln.split("\t")[-1] and not ln.startswith("-") for ln in jobs.splitlines())
            c = conf.get(bundle_id, {})
            space = space_of(bundle_id)
            out.append({"id": bundle_id, "name": app.stem, "path": str(app), "sandboxed": cache[key]["sandboxed"],
                        "perms": [t(PERMISSIONS[k], PERMISSIONS_EN[k]) for k in cache[key]["perm_keys"]], "inside": inside, "running": f"{app}/Contents/MacOS/{exe}" in procs,
                        "tz": c.get("tz"), "mode": effective_mode(bundle_id, c, load_rule(bundle_id)),
                        "bringOld": bool(c.get("bring_old_data")), "block": blocked_devices(c, cache[key]["inj"] or opt(load_rule(bundle_id), c, "clone")), "clipboard": clipboard_mode(c, cache[key]["inj"] or opt(load_rule(bundle_id), c, "clone")), "injectable": cache[key]["inj"] or opt(load_rule(bundle_id), c, "clone"), "canClone": not cache[key]["inj"], "location": c.get("location"), "identity": c.get("identity"), "allow": c.get("allow", []), "allowOpen": bool(c.get("allow_open")), "options": {k: opt(load_rule(bundle_id), c, v) for k, v in OPTIONS.items()}, "autoEnabled": c.get("auto_enabled", []), "tuned": bool(c.get("tuned")), "reviewed": bool(c.get("decided")), "space": str(space), "hasSpace": space.exists(), "added": str(app) in added})
    if "_added" not in conf:  # 有“添加”之前就在结界里用过的软件，直接算已添加
        conf["_added"] = sorted(e["path"] for e in out if e["hasSpace"] or e["id"] in conf)
        save_settings(conf)
        for e in out:
            e["added"] = e["path"] in conf["_added"]
    STATE.mkdir(parents=True, exist_ok=True)
    cache_path.write_text(json.dumps(cache))
    print(json.dumps(out, ensure_ascii=False))


def migrate_spaces():
    """旧位置搬到 .noindex，旧路径留一个链接，软件存下的旧绝对路径照样能用。有软件正在里面运行就先不搬。"""
    global SPACES, LIBDIR
    if not OLD_SPACES.is_dir() or OLD_SPACES.is_symlink():
        return
    if SPACES.exists() or any(job_state(p.name)[0] for p in OLD_SPACES.iterdir()):
        SPACES, LIBDIR = OLD_SPACES, OLD_SPACES / ".lib"
        return
    os.rename(OLD_SPACES, SPACES)
    OLD_SPACES.symlink_to(SPACES)


def main():
    migrate_spaces()
    a = sys.argv[1:]
    if a == ["list"]:
        return list_apps()
    if len(a) == 3 and a[0] == "set-tz":
        return set_tz(a[1], a[2])
    if len(a) == 3 and a[0] == "set-mode" and a[2] in ("space", "real"):
        return set_field(a[1], "mode", a[2])
    if len(a) == 3 and a[0] == "set-bring-old" and a[2] in ("on", "off"):
        return set_field(a[1], "bring_old_data", True if a[2] == "on" else "-")
    if len(a) == 4 and a[0] == "allow" and a[2] in ("add", "rm"):
        return set_allow(a[1], a[2], a[3])
    if len(a) == 2 and a[0] == "new-identity":
        return set_field(a[1], "identity", "-")  # 下次打开时生成新的一套
    if a[:1] == ["set-location"] and (a[2:] == ["-"] or len(a) >= 4):
        return set_location(a[1], a[2:])
    if len(a) == 4 and a[0] == "set" and a[2] in OPTIONS and a[3] in ("on", "off"):
        return set_field(a[1], OPTIONS[a[2]], a[3] == "on")
    if len(a) == 3 and a[0] == "set-open" and a[2] in ("on", "off"):
        return set_field(a[1], "allow_open", True if a[2] == "on" else "-")
    if len(a) == 4 and a[0] == "set-block" and a[2] in DEVICES and a[3] in ("on", "off"):
        return set_block(a[1], a[2], a[3] == "on")
    if len(a) == 3 and a[0] == "set-clipboard" and a[2] in ("off", "paste", "on"):
        return set_clipboard(a[1], a[2])
    if a[:1] == ["never"] and (a[1:] == ["list"] or (len(a) == 3 and a[1] in ("add", "rm"))):
        return never_cmd(*a[1:])
    if len(a) >= 4 and a[0] == "decide" and a[2] in ("allow", "deny"):
        return decide(a[1], a[2], " ".join(a[3:]))
    if len(a) == 2 and a[0] == "add":
        return add(a[1])
    if len(a) == 2 and a[0] == "remove":
        return remove(a[1])
    if len(a) == 2 and a[0] == "trial":
        return trial(a[1])
    if len(a) == 2 and a[0] == "blocked":
        return blocked(a[1])
    if len(a) == 3 and a[0] == "blocked" and a[2] == "--json":
        return blocked(a[1], as_json=True)
    if len(a) == 2 and a[0] == "import":
        bundle_id, _ = info(a[1])
        stop(a[1])
        app = str(Path(a[1]).resolve())
        sandboxed = bool(entitlements(app).get("com.apple.security.app-sandbox"))
        msg = import_container(bundle_id) if sandboxed else import_own(app, bundle_id, load_rule(bundle_id))
        if msg:
            sys.exit(msg)
        return
    if len(a) == 2 and a[0] == "tune":
        return tune(a[1])
    if len(a) in (2, 3) and a[0] == "launcher":
        return make_launcher(*a[1:])
    if len(a) != 2 or a[0] not in ("run", "learn", "report", "stop", "reset"):
        sys.exit(__doc__)
    if a[0] == "stop":
        return stop(a[1])
    if a[0] == "reset":
        return reset(a[1])
    if a[0] == "report":
        return report(a[1])
    msg = run(a[1], learn=a[0] == "learn")
    if msg:
        print(msg)
        sys.exit(1)
    bundle_id, _ = info(a[1])
    if a[0] == "run" and not settings().get(bundle_id, {}).get("tuned"):
        # 第一次打开：后台盯着，必要时自动放开权限重开；不拖住界面
        subprocess.Popen([str(ROOT / "kekkai"), "tune", a[1]], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
