def t(zh, en):
    return zh if os.environ.get("KEKKAI_LANG", "zh") == "zh" else en


def q(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def info(app):
    plist = plistlib.load(open(Path(app, "Contents/Info.plist"), "rb"))
    bundle_id = plist["CFBundleIdentifier"]
    if bundle_id == "com.github.Electron":  # 有的软件没改 Electron 的默认 id，按 App 名区分
        bundle_id += "." + re.sub(r"[^A-Za-z0-9.-]", "-", Path(app).stem)
    return bundle_id, plist["CFBundleExecutable"]


def load_rule(bundle_id):
    p = ROOT / "rules" / f"{bundle_id}.json"
    return json.loads(p.read_text()) if p.exists() else {}


def entitlements(app):
    r = subprocess.run(["codesign", "-d", "--entitlements", "-", "--xml", app], capture_output=True)
    try:
        return plistlib.loads(r.stdout) if r.stdout else {}
    except Exception:
        return {}


def injectable(app):
    """签名允许注入才注入：强化运行时要同时许可环境变量和外来库，否则系统会拒绝启动或忽略。"""
    out = subprocess.run(["codesign", "-dv", app], capture_output=True, text=True).stderr
    m = re.search(r"flags=0x([0-9a-f]+)", out)
    flags = int(m.group(1), 16) if m else 0
    ents = entitlements(app)
    no_validation = ents.get("com.apple.security.cs.disable-library-validation")
    if flags & 0x10000:  # 强化运行时
        return bool(ents.get("com.apple.security.cs.allow-dyld-environment-variables") and no_validation)
    return not (flags & 0x2000) or bool(no_validation)  # 0x2000：只许加载同一开发者签的库


# 会认出这台 Mac 的硬件属性；能注入的软件拿到假值，不能注入的直接拿不到
