#!/usr/bin/python3 -I
"""结界 Kekkai：让 macOS App 只看得到自己的文件。
用法:
  kekkai run|learn|stop|report|reset|blocked <App.app>
  kekkai list
  kekkai set-tz <bundle id> <时区|->
  kekkai set-mode <bundle id> <space|real>
  kekkai set-bring-old <bundle id> <on|off>
  kekkai set-block <bundle id> clipboard <on|off>
  kekkai set-open <bundle id> <on|off>
  kekkai allow <bundle id> add|rm <文件夹>
  kekkai set-location <bundle id> <WGS-84 纬度> <经度> [名称] | -
  kekkai never list|add|rm [路径]
"""
import json, os, plistlib, re, shutil, subprocess, sys
from pathlib import Path

HOME = str(Path.home())
UID = os.getuid()
ROOT = Path(__file__).resolve().parent
STATE = Path(HOME, "Library/Application Support/Kekkai")
SPACES = Path("/Users/Shared/Kekkai")
OWN_BASES = ["Application Support", "Caches", "Preferences", "Logs", "HTTPStorages", "WebKit", "Cookies",
             "Saved Application State", "Containers", "Group Containers", "Application Scripts"]
BLOCKED = [HOME, "/Users/Shared", "/Applications", "/Volumes", "/private/tmp"]
NO_EXEC = ["/bin/launchctl", "/usr/bin/open", "/usr/bin/osascript"]
DIRECTORY_SERVICES = ["com.apple.system.opendirectoryd.libinfo", "com.apple.system.opendirectoryd.api",
                      "com.apple.system.opendirectoryd.membership", "com.apple.system.DirectoryService.libinfo_v1"]
DEFAULT_NEVER = [f"{HOME}/.ssh", f"{HOME}/.gnupg", f"{HOME}/.aws"]
# 可按 App 关掉的服务。摄像头、麦克风、定位由系统按软件管理，不在这里重复
DEVICES = {
    "clipboard": ['(deny mach-lookup (global-name "com.apple.pasteboard.1"))'],
}
DEFAULT_BLOCK = []
NAME_BASES = ["Application Support", "Caches", "Logs", "HTTPStorages", "WebKit", "Saved Application State"]
SPACE_DIRS = ["Library/Application Support", "Library/Caches", "Library/Preferences", "Library/Logs",
              "Downloads", "Documents", "Desktop", "tmp"]
PERMISSIONS_EN = {
    "com.apple.security.files.downloads.read-write": "Read and write Downloads",
    "com.apple.security.files.user-selected.read-write": "Read and write files you choose",
    "com.apple.security.files.user-selected.read-only": "Read files you choose",
    "com.apple.security.files.bookmarks.app-scope": "Remember files you chose",
